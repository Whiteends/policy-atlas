{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Whiteends/policy-atlas/main/schemas/policy-library-schema-v1.json",
  "title": "Policy Atlas policy library",
  "description": "The human-readable Conditional Access controls used by the report and policy library.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policies"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "policies": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": { "$ref": "#/$defs/policy" }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "maturity_stage", "description", "conditions", "grant_controls", "why_it_matters", "gotchas"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 3 },
        "category": { "type": "string", "minLength": 3 },
        "maturity_stage": { "type": "integer", "minimum": 1, "maximum": 4 },
        "description": { "type": "string", "minLength": 20 },
        "conditions": { "type": "string", "minLength": 3 },
        "grant_controls": { "type": "string", "minLength": 3 },
        "why_it_matters": { "type": "string", "minLength": 20 },
        "gotchas": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        }
      }
    }
  }
}
